{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/droggy992/htmem/schemas/thread.schema.json",
  "title": "htmem thread manifest",
  "description": "Multi-turn agent-to-agent communication record.",
  "type": "object",
  "additionalProperties": false,
  "$defs": {
    "safeText": {
      "description": "Rejects BMP-encodable zero-width / RTL-override / format / BOM chars; sanitize.py additionally strips non-BMP tag-block (U+E0000-U+E007F).",
      "not": {
        "pattern": "[\\u200B-\\u200F\\u202A-\\u202E\\u2060-\\u206F\\uFEFF\\uFFF9-\\uFFFB]|[\\uDB40][\\uDC00-\\uDC7F]"
      }
    }
  },
  "required": ["htmem_version", "id", "type", "title", "version", "created", "updated", "author", "summary", "participants", "turns"],
  "properties": {
    "htmem_version": {"type": "string", "const": "0.1"},
    "id": {"type": "string", "pattern": "^[a-zA-Z0-9_-]{8,64}$"},
    "type": {"type": "string", "const": "thread"},
    "title": {"allOf": [{"$ref": "#/$defs/safeText"}, {"type": "string", "minLength": 1, "maxLength": 240}]},
    "version": {"type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+(?:[-+][a-zA-Z0-9.-]+)?$"},
    "created": {"type": "string", "format": "date-time"},
    "updated": {"type": "string", "format": "date-time"},
    "author": {"allOf": [{"$ref": "#/$defs/safeText"}, {"type": "string", "minLength": 1, "maxLength": 200}]},
    "summary": {"allOf": [{"$ref": "#/$defs/safeText"}, {"type": "string", "minLength": 1, "maxLength": 480}]},
    "status": {"type": "string", "enum": ["open", "handed_off", "closed", "stalled"]},
    "participants": {
      "type": "array",
      "minItems": 2,
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "role"],
        "properties": {
          "name": {"type": "string", "maxLength": 200},
          "role": {"type": "string", "maxLength": 100, "description": "e.g. 'researcher', 'reviewer', 'implementer', 'user'"},
          "model": {"type": "string", "maxLength": 200, "description": "e.g. 'claude-opus-4-7', 'gpt-5', 'human'"}
        }
      }
    },
    "turns": {
      "type": "array",
      "minItems": 1,
      "maxItems": 500,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["from", "at", "text"],
        "properties": {
          "from": {"type": "string", "maxLength": 200},
          "to": {"type": "string", "maxLength": 200},
          "at": {"type": "string", "format": "date-time"},
          "text": {"type": "string", "maxLength": 20000},
          "kind": {"type": "string", "enum": ["question", "answer", "assertion", "handoff", "system_note"]},
          "evidence": {
            "type": "array",
            "maxItems": 10,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["source"],
              "properties": {
                "source": {"type": "string", "maxLength": 200},
                "url": {"type": "string", "format": "uri", "maxLength": 1000},
                "quote": {"type": "string", "maxLength": 2000}
              }
            }
          }
        }
      }
    },
    "outcome": {"type": "string", "maxLength": 4000, "description": "Net result of the thread — useful for fast scanning."},
    "next_action": {"type": "string", "maxLength": 1000},
    "related": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "relation"],
        "properties": {
          "id": {"type": "string", "maxLength": 200},
          "relation": {"type": "string", "enum": ["supersedes", "superseded_by", "implements", "implemented_by", "references", "rationale_for", "blocks", "blocked_by"]}
        }
      }
    },
    "anchor": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}
  }
}
